{
  "manifest_version": 3,
  "name": "Comprehensive Phishing Detector",
  "version": "2.0.0",
  "description": "AI-powered comprehensive URL scanner with deep analysis using VirusTotal and additional threat intelligence APIs",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "https://api.whois.vu/*",
    "http://ip-api.com/*",
    "https://rdap.verisign.com/*",
    "https://rdap.iana.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comprehensive Phishing Detector"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}