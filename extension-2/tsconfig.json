// tsconfig.json (Simplified for extensions)
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist" // Output compiled JS files here
  },
  "include": ["src/**/*.ts"] // Source files will be in a 'src' directory
}
