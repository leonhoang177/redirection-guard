{
  "manifest_version": 3,
  "name": "Redirect Guard",
  "version": "2.0.3",
  "description": "AI-powered redirect protection that detects and blocks suspicious redirects in real-time using VirusTotal intelligence.",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redirect Guard - Click to configure"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "loading.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
